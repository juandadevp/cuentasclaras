# Copia este archivo como .env.local y completa los valores.
# Los encuentras en Supabase: Project Settings > API (o el botón "Connect").

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (publishable / anon). NUNCA pongas aquí la service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: URL pública del sitio (para los enlaces de confirmación por correo).
# Si no la defines se usa la del navegador. Ejemplo en producción: https://cuentasclaras.com
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
