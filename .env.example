# Copia este archivo como .env.local y completa los valores.
# Los encuentras en Supabase: Project Settings > API (o el botón "Connect").

NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (publishable / anon). NUNCA pongas aquí la service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: URL pública del sitio (para los enlaces de confirmación por correo).
# Si no la defines se usa la del navegador. Ejemplo en producción: https://cuentasclaras.com
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Recomendar compras (comparador de precios) ---
# Clave de SerpApi (https://serpapi.com): consulta Google Shopping de Colombia con muchas tiendas.
# Es SECRETA: no lleva el prefijo NEXT_PUBLIC_ y solo se usa en el servidor.
# Sin esta clave el comparador funciona en modo demostración con precios de ejemplo.
SERPAPI_API_KEY=

# Opcional: dirección del servicio de precios, para probar con un servidor falso sin gastar cuota.
# Debe empezar por https:// (o http://localhost). Si no la defines se usa la de SerpApi.
# PRECIOS_API_URL=
